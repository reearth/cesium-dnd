{
  "version": "1.1.0",
  "license": "MIT",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest",
    "lint": "eslint .",
    "size": "size-limit",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "peerDependencies": {
    "cesium": "*"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": true,
    "arrowParens": "avoid",
    "proseWrap": "preserve"
  },
  "name": "cesium-dnd",
  "author": "HideBa",
  "main": "dist/cesium-dnd.umd.js",
  "module": "dist/cesium-dnd.es.js",
  "exports": {
    ".": {
      "import": "./dist/cesium-dnd.es.js",
      "require": "./dist/cesium-dnd.umd.js"
    }
  },
  "typings": "dist/index.d.ts",
  "size-limit": [
    {
      "path": "dist/cesium-dnd.umd.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/cesium-dnd.es.js",
      "limit": "10 KB"
    }
  ],
  "lint-staged": {
    "*.js": "eslint . --fix",
    "*.ts": "eslint . --fix"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/cesium": "^1.70.4",
    "cesium": "^1.94.2",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-prettier": "^5.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "^3.6.2",
    "size-limit": "^11.2.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  }
}
